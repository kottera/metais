{%- assign inv = inputs.invoice -%}
{%- assign subtotal = 0 -%}
{%- for item in inputs.line_items -%}
  {%- assign line = item.quantity | times: item.unit_price | times: 100 | round -%}
  {%- assign subtotal = subtotal | plus: line -%}
{%- endfor -%}
{%- assign tax = 0 -%}
{%- if inv.tax -%}
  {%- assign tax = subtotal | times: inv.tax.rate | divided_by: 100.0 | round -%}
{%- endif -%}
{%- assign total = subtotal | plus: tax -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Invoice {{ inv.number }} — {{ inv.seller.name }}</title>
<style>
  @page { size: auto; margin: 18mm; }
  * { box-sizing: border-box; }
  body { margin: 0; background: #f4f4f5; color: #1f2328; font: 14px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
  .page { max-width: 800px; margin: 32px auto; padding: 48px; background: #fff; border-radius: 6px; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
  header { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; margin-bottom: 40px; }
  h1 { margin: 0; font-size: 28px; letter-spacing: .04em; text-transform: uppercase; }
  .seller-name { font-size: 18px; font-weight: 600; }
  .meta { margin: 8px 0 0; border-collapse: collapse; }
  .meta th { padding: 0 16px 0 0; text-align: left; font-weight: 500; color: #59636e; }
  .meta td { padding: 0; }
  .parties { display: flex; gap: 48px; margin-bottom: 32px; }
  .parties > div { flex: 1; }
  .label { margin: 0 0 4px; font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: #59636e; }
  address { font-style: normal; }
  table.items { width: 100%; border-collapse: collapse; }
  table.items th { padding: 8px; border-bottom: 2px solid #1f2328; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; text-align: left; }
  table.items td { padding: 10px 8px; border-bottom: 1px solid #e4e4e7; vertical-align: top; }
  table.items .num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .totals { margin: 16px 0 0 auto; border-collapse: collapse; min-width: 280px; }
  .totals th { padding: 6px 8px; text-align: left; font-weight: 400; color: #59636e; }
  .totals td { padding: 6px 8px; text-align: right; font-variant-numeric: tabular-nums; }
  .totals .grand th, .totals .grand td { padding-top: 12px; border-top: 2px solid #1f2328; font-size: 18px; font-weight: 700; color: #1f2328; }
  .foot { margin-top: 40px; padding-top: 16px; border-top: 1px solid #e4e4e7; }
  .foot p { margin: 0 0 12px; white-space: pre-line; }
  @media print {
    body { background: none; }
    .page { margin: 0; padding: 0; max-width: none; box-shadow: none; }
  }
</style>
</head>
<body>
<main class="page">
  <header>
    <div>
      <div class="seller-name">{{ inv.seller.name }}</div>
      {%- if inv.seller.address %}
      <address>{% for address_line in inv.seller.address %}{{ address_line }}{% unless forloop.last %}<br>{% endunless %}{% endfor %}</address>
      {%- endif %}
      {%- if inv.seller.email %}
      <div>{{ inv.seller.email }}</div>
      {%- endif %}
      {%- if inv.seller.tax_id %}
      <div>Tax ID: {{ inv.seller.tax_id }}</div>
      {%- endif %}
    </div>
    <div>
      <h1>Invoice</h1>
      <table class="meta">
        <tr><th>Number</th><td>{{ inv.number }}</td></tr>
        <tr><th>Issued</th><td><time datetime="{{ inv.issue_date }}">{{ inv.issue_date | date: "%-d %B %Y" }}</time></td></tr>
        {%- if inv.due_date %}
        <tr><th>Due</th><td><time datetime="{{ inv.due_date }}">{{ inv.due_date | date: "%-d %B %Y" }}</time></td></tr>
        {%- endif %}
      </table>
    </div>
  </header>

  <section class="parties">
    <div>
      <p class="label">Bill to</p>
      <div><strong>{{ inv.buyer.name }}</strong></div>
      {%- if inv.buyer.address %}
      <address>{% for address_line in inv.buyer.address %}{{ address_line }}{% unless forloop.last %}<br>{% endunless %}{% endfor %}</address>
      {%- endif %}
      {%- if inv.buyer.email %}
      <div>{{ inv.buyer.email }}</div>
      {%- endif %}
      {%- if inv.buyer.tax_id %}
      <div>Tax ID: {{ inv.buyer.tax_id }}</div>
      {%- endif %}
    </div>
  </section>

  <table class="items">
    <thead>
      <tr>
        <th>Description</th>
        <th class="num">Quantity</th>
        <th class="num">Unit price</th>
        <th class="num">Amount ({{ inv.currency }})</th>
      </tr>
    </thead>
    <tbody>
      {%- for item in inputs.line_items %}
      {%- assign price = item.unit_price | times: 100 | round %}
      {%- assign line = item.quantity | times: item.unit_price | times: 100 | round %}
      <tr>
        <td>{{ item.description }}</td>
        <td class="num">{{ item.quantity }}</td>
        <td class="num">{% render "money.liquid", cents: price %}{% if item.unit %} / {{ item.unit }}{% endif %}</td>
        <td class="num">{% render "money.liquid", cents: line %}</td>
      </tr>
      {%- endfor %}
    </tbody>
  </table>

  <table class="totals">
    <tr><th>Subtotal</th><td>{% render "money.liquid", cents: subtotal %}</td></tr>
    {%- if inv.tax %}
    <tr><th>{{ inv.tax.label | default: "Tax" }} ({{ inv.tax.rate }}%)</th><td>{% render "money.liquid", cents: tax %}</td></tr>
    {%- endif %}
    <tr class="grand"><th>Total due</th><td>{{ inv.currency }} {% render "money.liquid", cents: total %}</td></tr>
  </table>
  {%- if inv.payment_terms or inv.notes %}

  <footer class="foot">
    {%- if inv.payment_terms %}
    <p class="label">Payment</p>
    <p>{{ inv.payment_terms }}</p>
    {%- endif %}
    {%- if inv.notes %}
    <p>{{ inv.notes }}</p>
    {%- endif %}
  </footer>
  {%- endif %}
</main>
</body>
</html>
