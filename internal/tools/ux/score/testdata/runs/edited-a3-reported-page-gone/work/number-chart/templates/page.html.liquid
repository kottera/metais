{%- comment %}
metais.yaml declares this output's escape: html, so every value written
with {{ }} is HTML-escaped. The numbers reach the script through json_script,
which no value can break out of; never json.
{% endcomment -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ inputs.data.title }}</title>
<style>
  :root { color-scheme: light dark; --fg: #1f2328; --muted: #656d76; --grid: #d0d7de; --bar: #2f6fdf; --bar-hover: #1a4fb0; --bg: #ffffff; }
  @media (prefers-color-scheme: dark) {
    :root { --fg: #e6edf3; --muted: #9198a1; --grid: #3d444d; --bar: #5b93f0; --bar-hover: #8ab4f8; --bg: #0d1117; }
  }
  body { margin: 2rem; font: 14px/1.4 system-ui, sans-serif; color: var(--fg); background: var(--bg); }
  h1 { font-size: 1.25rem; font-weight: 600; margin: 0 0 1rem; }
  #chart { width: 100%; max-width: 960px; }
  #chart svg { display: block; width: 100%; height: auto; overflow: visible; }
  .grid line { stroke: var(--grid); stroke-width: 1; }
  .zero { stroke: var(--fg); stroke-width: 1; }
  .tick { fill: var(--muted); font-size: 11px; font-variant-numeric: tabular-nums; }
  .bar { fill: var(--bar); }
  .bar:hover { fill: var(--bar-hover); }
</style>
</head>
<body>
<h1>{{ inputs.data.title }}</h1>
<div id="chart"></div>
<script>
const values = {{ inputs.data.values | json_script }};
const unit = {{ inputs.data.unit | default: "" | json_script }};

(function draw() {
  const NS = "http://www.w3.org/2000/svg";
  const W = 960, H = 400, M = { top: 12, right: 12, bottom: 28, left: 64 };
  const plotW = W - M.left - M.right, plotH = H - M.top - M.bottom;

  const lo = Math.min(0, ...values), hi = Math.max(0, ...values);
  const ticks = niceTicks(lo, hi === lo ? lo + 1 : hi, 5);
  const yMin = ticks[0], yMax = ticks[ticks.length - 1];
  const y = v => M.top + plotH * (yMax - v) / (yMax - yMin);

  const fmt = new Intl.NumberFormat(undefined, { maximumFractionDigits: 6 });
  const label = v => fmt.format(v) + (unit ? " " + unit : "");

  const svg = el("svg", { viewBox: `0 0 ${W} ${H}`, role: "img", "aria-label": document.title });

  const grid = el("g", { class: "grid" });
  for (const t of ticks) {
    grid.append(el("line", { x1: M.left, x2: W - M.right, y1: y(t), y2: y(t) }));
    grid.append(text(label(t), { x: M.left - 8, y: y(t), "text-anchor": "end", "dominant-baseline": "middle" }));
  }
  svg.append(grid);

  const step = plotW / values.length;
  const gap = values.length > 1 ? Math.min(step * 0.2, 8) : 0;
  values.forEach((v, i) => {
    const top = y(Math.max(v, 0)), bottom = y(Math.min(v, 0));
    const bar = el("rect", { class: "bar", x: M.left + i * step + gap / 2, y: top, width: Math.max(step - gap, 1), height: Math.max(bottom - top, 0.5) });
    const tip = el("title");
    tip.textContent = `#${i + 1}: ${label(v)}`;
    bar.append(tip);
    svg.append(bar);
  });

  svg.append(el("line", { class: "zero", x1: M.left, x2: W - M.right, y1: y(0), y2: y(0) }));

  const every = Math.ceil(values.length / 20);
  for (let i = 0; i < values.length; i += every) {
    svg.append(text(String(i + 1), { x: M.left + (i + 0.5) * step, y: H - M.bottom + 16, "text-anchor": "middle" }));
  }

  document.getElementById("chart").append(svg);

  function el(name, attrs = {}) {
    const node = document.createElementNS(NS, name);
    for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, v);
    return node;
  }

  function text(content, attrs) {
    const node = el("text", { class: "tick", ...attrs });
    node.textContent = content;
    return node;
  }

  function niceTicks(min, max, count) {
    const raw = (max - min) / count;
    const mag = Math.pow(10, Math.floor(Math.log10(raw)));
    const step = [1, 2, 2.5, 5, 10].map(s => s * mag).find(s => s >= raw);
    const out = [];
    const first = Math.floor(min / step), last = Math.ceil(max / step);
    for (let k = first; k <= last; k++) out.push(+(k * step).toPrecision(12));
    return out;
  }
})();
</script>
</body>
</html>
