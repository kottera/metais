tion\": \"The competent authority's reference for the incident, given once it has assigned one. Mandatory when its condition holds.\",\n          \"examples\": [\n            \"CA-2026-117\"\n          ],\n          \"minLength\": 1,\n          \"title\": \"3.1 Incident reference code provided by the competent authority\",\n          \"type\": \"string\",\n          \"x-field\": \"3.1\",\n          \"x-field-type\": \"Alphanumeric\"\n        },\n        \"business_continuity_plan_activated\": {\n          \"description\": \"Whether the business continuity plan was activated. Mandatory in the initial notification, the intermediate report and the final report.\",\n          \"examples\": [\n            true\n          ],\n          \"title\": \"2.9 Activation of business continuity plan, if activated\",\n          \"type\": \"boolean\",\n          \"x-field\": \"2.9\",\n          \"x-field-type\": \"Boolean (Yes or No)\"\n        },\n        \"classification_criteria\": {\n          \"description\": \"Every classification criterion of Delegated Regulation (EU) 2024/1772 the incident met. Mandatory in the initial notification, the intermediate report and the final report.\",\n          \"items\": {\n            \"enum\": [\n              \"clients, financial counterparts and transactions affected\",\n              \"reputational impact\",\n              \"duration and service downtime\",\n              \"geographical spread\",\n              \"data losses\",\n              \"critical services affected\",\n              \"economic impact\"\n            ]\n          },\n          \"minItems\": 1,\n          \"title\": \"2.5 Classification criteria that triggered the incident report\",\n          \"type\": \"array\",\n          \"uniqueItems\": true,\n          \"x-field\": \"2.5\",\n          \"x-field-type\": \"Choice (multiple)\"\n        },\n        \"classified_at\": {\n          \"description\": \"When the incident was classified as major, in UTC. Mandatory in the initial notification, the intermediate report and the final report.\",\n          \"examples\": [\n            \"2026-03-02T08:10:00Z\"\n          ],\n          \"format\": \"date-time\",\n          \"pattern\": \"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$\",\n          \"title\": \"2.3 Date and time of classification of the incident as major\",\n          \"type\": \"string\",\n          \"x-field\": \"2.3\",\n          \"x-field-type\": \"ISO 8601 standard UTC (YYYY-MM-DD Thh: mm:ss)\"\n        },\n        \"client_financial_interest_impact\": {\n          \"description\": \"Whether the incident affected the financial interests of clients. Mandatory in the intermediate report and the final report.\",\n          \"enum\": [\n            \"Yes\",\n            \"No\",\n            \"Information not available\"\n          ],\n          \"title\": \"3.30 Impact on the financial interest of clients\",\n          \"x-field\": \"3.30\",\n          \"x-field-type\": \"Choice\"\n        },\n        \"clients_affected\": {\n          \"description\": \"How many clients the incident affected. Mandatory in the intermediate report and the final report.\",\n          \"examples\": [\n            18500\n          ],\n          \"minimum\": 0,\n          \"title\": \"3.4 Number of clients affected\",\n          \"type\": \"integer\",\n          \"x-field\": \"3.4\",\n          \"x-field-type\": \"Numerical integer\"\n        },\n        \"clients_affected_percentage\": {\n          \"description\": \"The clients affected, as a percentage of all the financial entity's clients. Mandatory in the intermediate report and the final report.\",\n          \"examples\": [\n            4.2\n          ],\n          \"maximum\": 100,\n          \"minimum\": 0,\n          \"title\": \"3.5 Percentage of clients affected\",\n          \"type\": \"number\",\n          \"x-field\": \"3.5\",\n          \"x-field-type\": \"Expressed as percentage – any value up to 5 numeric characters i