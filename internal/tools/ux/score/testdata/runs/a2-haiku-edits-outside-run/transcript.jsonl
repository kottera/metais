 name: invoice\n    title: \"Invoice\"\n    description: \"One invoice, as the billing program that issues it holds it.\"\n    schema: inputs/invoice.schema.json\n    forms:\n      - json\noutputs:\n  - id: invoice\n    template: invoice.html.liquid\n    escape: html\n","structuredPatch":[{"oldStart":6,"oldLines":7,"newStart":6,"newLines":8,"lines":[" license: \"Apache-2.0\""," guide: |-","   This package renders invoice.html, an HTML page that prints one invoice:","-  its number and the date it was issued, the seller and the buyer, a table","+  its number, the date it was issued and, when given, the date it is due,","+  the seller and the buyer, a table","   of the items invoiced with each line's amount, the total, and optional","   notes. The page carries class names and no style of its own."," "]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_015wVqrT65D8uA7UDe7RaBYk","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
