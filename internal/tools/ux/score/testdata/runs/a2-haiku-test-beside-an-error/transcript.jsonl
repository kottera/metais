\": \"#/$defs/party\",\n      \"title\": \"Seller\",\n      \"description\": \"Who issues the invoice and is to be paid.\"\n    },\n    \"buyer\": {\n      \"$ref\": \"#/$defs/party\",\n      \"title\": \"Buyer\",\n      \"description\": \"Who the invoice is issued to and is to pay.\"\n    },\n    \"currency\": {\n      \"type\": \"string\",\n      \"pattern\": \"^[A-Z]{3}$\",\n      \"title\": \"Currency\",\n      \"description\": \"The currency of every amount on the invoice, as its three-letter ISO 4217 code.\",\n      \"examples\": [\"EUR\"]\n    },\n    \"lines\": {\n      \"type\": \"array\",\n      \"minItems\": 1,\n      \"maxItems\": 100,\n      \"title\": \"Lines\",\n      \"description\": \"The items invoiced, in the order the table lists them.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\"description\", \"quantity\", \"unit_price\"],\n        \"properties\": {\n          \"description\": {\n            \"type\": \"string\",\n            \"minLength\": 1,\n            \"maxLength\": 200,\n            \"title\": \"Description\",\n            \"description\": \"What the line invoices, as the table prints it.\",\n            \"examples\": [\"Consulting, October\"]\n          },\n          \"quantity\": {\n            \"type\": \"number\",\n            \"exclusiveMinimum\": 0,\n            \"title\": \"Quantity\",\n            \"description\": \"How many units the line invoices: hours, days or items. It may be fractional.\",\n            \"examples\": [12]\n          },\n          \"unit_price\": {\n            \"type\": \"number\",\n            \"minimum\": 0,\n            \"title\": \"Unit price\",\n            \"description\": \"The price of one unit, in the invoice's currency.\",\n            \"examples\": [95]\n          }\n        }\n      }\n    },\n    \"notes\": {\n      \"type\": \"string\",\n      \"minLength\": 1,\n      \"maxLength\": 1000,\n      \"title\": \"Notes\",\n      \"description\": \"Anything the buyer should read beside the amounts, such as how to pay. Left out, the invoice prints no notes.\"\n    }\n  },\n  \"$defs\": {\n    \"party\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"name\", \"address\"],\n      \"title\": \"Party\",\n      \"description\": \"A person or organization named on the invoice.\",\n      \"properties\": {\n        \"name\": {\n          \"type\": \"string\",\n          \"minLength\": 1,\n          \"maxLength\": 120,\n          \"title\": \"Name\",\n          \"description\": \"The party's name, as the invoice prints it.\",\n          \"examples\": [\"Example Consulting B.V.\"]\n        },\n        \"address\": {\n          \"type\": \"string\",\n          \"minLength\": 1,\n          \"maxLength\": 300,\n          \"title\": \"Address\",\n          \"description\": \"The party's postal address, on one line, as the invoice prints it.\",\n          \"examples\": [\"Keizersgracht 1, 1015 CC Amsterdam, Netherlands\"]\n        }\n      }\n    }\n  }\n}\n","structuredPatch":[{"oldStart":21,"oldLines":6,"newStart":21,"newLines":13,"lines":["       \"description\": \"The date the invoice was issued, as an RFC 3339 full-date. The invoice prints it as given.\",","       \"examples\": [\"2026-10-21\"]","     },","+    \"due\": {","+      \"type\": \"string\",","+      \"format\": \"date\",","+      \"title\": \"Due\",","+      \"description\": \"The date the invoice is due for payment, as an RFC 3339 full-date. The invoice prints it as given. Left out, the invoice prints no due date.\",","+      \"examples\": [\"2026-11-20\"]","+    },","     \"seller\": {","       \"$ref\": \"#/$defs/party\",","       \"title\": \"Seller\","]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_01QMo7uJnzmMNaqQzp3xrY8u","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
