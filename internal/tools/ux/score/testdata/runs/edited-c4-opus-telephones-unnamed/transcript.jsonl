dent/impact_figures_basis/*\tany\toptional\tenum=[\"actual figures for clients affected\",\"actual figures for financial counterparts affected\",\"actual figures for transactions affected\",\"estimates for clients affected\",\"estimates for financial counterparts affected\",\"estimates for transactions affected\",\"no impact on clients\",\"no impact on financial counterparts\",\"no impact on transactions\"]\t-\n/incident/incident_types\tarray\toptional\tminItems=1 uniqueItems=true\t3.23 Type of the incident\n/incident/incident_types/*\tany\toptional\tenum=[\"Cybersecurity-related\",\"Process failure\",\"System failure\",\"External event\",\"Payment-related\",\"Other (please specify)\"]\t-\n/incident/indicators_of_compromise\tstring\toptional\tminLength=1\t3.35 Indicators of compromise\n/incident/infrastructure_components_affected\tany\toptional\tenum=[\"Yes\",\"No\",\"Information not available\"]\t3.28 Affected infrastructure components supporting business processes\n/incident/infrastructure_components_description\tstring\toptional\tminLength=1\t3.29 Information about affected infrastructure components supporting business processes\n/incident/member_state_impact_description\tstring\toptional\tminLength=1\t3.19 Description of how the incident has an impact in other Member States\n/incident/member_state_impact_types\tarray\toptional\tminItems=1 uniqueItems=true\t3.18 Types of impact in the Member States\n/incident/member_state_impact_types/*\tany\toptional\tenum=[\"clients\",\"financial counterparts\",\"branch of the financial entity\",\"financial entities within the group carrying out activities in the respective Member State\",\"financial market infrastructure\",\"third-party providers that may be common to other financial entities\"]\t-\n/incident/occurred_at\tstring\toptional\tformat=\"date-time\" pattern=\"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$\"\t3.2 Date and time of occurrence of the incident\n/incident/originating_provider\tstring\toptional\tminLength=1\t2.8 Indication whether the incident originates from a third-party provider or another financial entity\n/incident/other_authorities\tstring\toptional\tminLength=1\t3.32 Specification of ‘other’ authorities\n/incident/other_authorities_informed\tarray\toptional\tminItems=1 uniqueItems=true\t3.31 Reporting to other authorities\n/incident/other_authorities_informed/*\tany\toptional\tenum=[\"Police/Law Enforcement\",\"CSIRT\",\"Data Protection Authority\",\"National Cybersecurity Agency\",\"None\",\"Other (please specify)\"]\t-\n/incident/other_incident_types\tstring\toptional\tminLength=1\t3.24 Other types of incidents\n/incident/other_information\tstring\toptional\tminLength=1\t2.10 Other relevant information\n/incident/other_root_causes\tstring\toptional\tminLength=1\t4.4 Other types of root cause types\n/incident/other_techniques\tstring\toptional\tminLength=1\t3.26 Other types of techniques\n/incident/recurring_incidents\tstring\toptional\tminLength=1\t4.15 Information on whether the non-major incidents have been recurring\n/incident/recurring_incidents_occurred_at\tstring\toptional\tformat=\"date-time\" pattern=\"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$\"\t4.16 Date and time of occurrence of recurring incidents\n/incident/reference_code\tstring\trequired\tminLength=1\t2.1 Incident reference code assigned by the financial entity\n/incident/relevant_clients_or_counterparts_impacted\tboolean\toptional\t-\t3.8 Impact on relevant clients or financial counterparts\n/incident/reputational_impact\tarray\toptional\tminItems=1 uniqueItems=true\t3.13 Reputational impact\n/incident/reputational_impact/*\tany\toptional\tenum=[\"the major ICT-related incident has been reflected in the media\",\"the major ICT-related incident has resulted in repetitive complaints from different clients or financial counterparts on client-facing services or critical business relationships\",\"the financial entity will not be able to or is likely not to be able to meet