otes\",\n      \"description\": \"Anything the buyer should read beside the amounts, such as how to pay. Left out, the invoice prints no notes.\"\n    }\n  },\n  \"$defs\": {\n    \"party\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"name\", \"address\"],\n      \"title\": \"Party\",\n      \"description\": \"A person or organization named on the invoice.\",\n      \"properties\": {\n        \"name\": {\n          \"type\": \"string\",\n          \"minLength\": 1,\n          \"maxLength\": 120,\n          \"title\": \"Name\",\n          \"description\": \"The party's name, as the invoice prints it.\",\n          \"examples\": [\"Example Consulting B.V.\"]\n        },\n        \"address\": {\n          \"type\": \"string\",\n          \"minLength\": 1,\n          \"maxLength\": 300,\n          \"title\": \"Address\",\n          \"description\": \"The party's postal address, on one line, as the invoice prints it.\",\n          \"examples\": [\"Keizersgracht 1, 1015 CC Amsterdam, Netherlands\"]\n        }\n      }\n    }\n  }\n}\n","structuredPatch":[{"oldStart":21,"oldLines":6,"newStart":21,"newLines":13,"lines":["       \"description\": \"The date the invoice was issued, as an RFC 3339 full-date. The invoice prints it as given.\",","       \"examples\": [\"2026-10-21\"]","     },","+    \"due\": {","+      \"type\": \"string\",","+      \"format\": \"date\",","+      \"title\": \"Due\",","+      \"description\": \"The date the invoice is to be paid by, as an RFC 3339 full-date. The invoice prints it as given. Left out, the invoice prints no due date.\",","+      \"examples\": [\"2026-11-20\"]","+    },","     \"seller\": {","       \"$ref\": \"#/$defs/party\",","       \"title\": \"Seller\","]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_01MmgXnKnFfUTzVLJd2ftqxE","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
