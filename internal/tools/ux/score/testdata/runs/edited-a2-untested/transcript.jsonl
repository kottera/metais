ass=\"invoice-notes\">{{ inv.notes }}</p>\n{%- endif %}\n</article>\n</body>\n</html>\n","structuredPatch":[{"oldStart":9,"oldLines":6,"newStart":9,"newLines":9,"lines":[" <article class=\"invoice\">","   <h1>Invoice {{ inv.number }}</h1>","   <p class=\"invoice-issued\">Issued <time datetime=\"{{ inv.issued }}\">{{ inv.issued }}</time></p>","+{%- if inv.due %}","+  <p class=\"invoice-due\">Due <time datetime=\"{{ inv.due }}\">{{ inv.due }}</time></p>","+{%- endif %}","   <section class=\"invoice-seller\">","     <h2>From</h2>","     <p>{{ inv.seller.name }}<br>{{ inv.seller.address }}</p>"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_01YTsRseix97sgXUX1GEjtim","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
