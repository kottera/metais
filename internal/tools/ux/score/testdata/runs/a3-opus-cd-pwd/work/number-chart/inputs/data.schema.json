{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data",
  "description": "The numbers to chart, and the chart's title.",
  "type": "object",
  "additionalProperties": false,
  "required": ["values"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "default": "Chart",
      "title": "Title",
      "description": "The page's title and heading."
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "title": "Values",
      "description": "The numbers to chart, in order; each is drawn as one bar.",
      "items": { "type": "number" }
    }
  }
}
