{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Invoice",
  "description": "One invoice: who bills whom, and the line items billed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["number", "issue_date", "currency", "seller", "customer", "items"],
  "$defs": {
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120, "description": "Legal or trading name." },
        "address": {
          "type": "array",
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": "Address lines, one entry per printed line."
        },
        "email": { "type": "string", "maxLength": 120, "description": "Contact email." }
      }
    }
  },
  "properties": {
    "number": { "type": "string", "minLength": 1, "maxLength": 40, "title": "Number", "description": "Invoice number.", "examples": ["INV-2026-014"] },
    "issue_date": { "type": "string", "format": "date", "title": "Issue date", "description": "Date issued, YYYY-MM-DD." },
    "due_date": { "type": "string", "format": "date", "title": "Due date", "description": "Date payment is due, YYYY-MM-DD. Omit if due on receipt." },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "title": "Currency", "description": "ISO 4217 code for every amount.", "examples": ["EUR"] },
    "seller": { "$ref": "#/$defs/party", "title": "Seller", "description": "Who issues the invoice." },
    "customer": { "$ref": "#/$defs/party", "title": "Customer", "description": "Who is billed." },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "title": "Line items",
      "description": "The lines billed, in print order.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "quantity", "unit_price"],
        "properties": {
          "description": { "type": "string", "minLength": 1, "maxLength": 200, "description": "What is billed." },
          "quantity": { "type": "number", "exclusiveMinimum": 0, "description": "Units billed." },
          "unit_price": { "type": "number", "minimum": 0, "description": "Price of one unit, before tax, in the major unit." }
        }
      }
    },
    "tax_rate": { "type": "number", "minimum": 0, "maximum": 100, "title": "Tax rate", "description": "Tax percentage on the subtotal. Omit for none." },
    "notes": { "type": "string", "maxLength": 600, "title": "Notes", "description": "Text under the totals, such as payment details." }
  }
}
