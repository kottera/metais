{%- comment -%}
One table of the JSON report: its standard; for WCAG 2.2, whose criterion
names and levels are excerpts of W3C's document, the source W3C's terms
require with them: its title, link, status and copyright notice; then its
summary, how many criteria rows lists and how many of them give each
conformance level; then a criterion object per entry of rows, in the order
supplied.
{%- endcomment -%}
{
      "standard": {{ standard | json }},
{%- if standard == "wcag" %}
      "source": {
        "title": "Web Content Accessibility Guidelines (WCAG) 2.2",
        "url": "https://www.w3.org/TR/2024/REC-WCAG22-20241212/",
        "status": "W3C Recommendation 12 December 2024",
        "notice": "Copyright © 2020-2024 World Wide Web Consortium. W3C® liability, trademark and document use rules apply."
      },
{%- endif %}
      "summary": {
        "criteria": {{ rows.size }},
        "conformance": {
          "Supports": {{ rows | where: "conformance", "Supports" | size }},
          "Partially Supports": {{ rows | where: "conformance", "Partially Supports" | size }},
          "Does Not Support": {{ rows | where: "conformance", "Does Not Support" | size }},
          "Not Applicable": {{ rows | where: "conformance", "Not Applicable" | size }},
          "Not Evaluated": {{ rows | where: "conformance", "Not Evaluated" | size }}
        }
      },
      "criteria": [
{%- for row in rows %}
        {
{%- case standard -%}
{%- when "wcag" -%}
{%- capture label %}{% render "criteria/wcag.liquid", id: row.criterion %}{% endcapture -%}
{%- capture level %}{% render "criteria/wcag-level.liquid", id: row.criterion %}{% endcapture -%}
{%- when "section508" -%}
{%- capture label %}{% render "criteria/section508.liquid", id: row.criterion %}{% endcapture -%}
{%- when "en301549" -%}
{%- capture label %}{% render "criteria/en301549.liquid", id: row.criterion %}{% endcapture -%}
{%- endcase %}
          "criterion": {{ row.criterion | json }},
          "label": {{ label | json }},
{%- if standard == "wcag" %}
          "wcag_level": {{ level | json }},
{%- endif %}
          "conformance": {{ row.conformance | json }},
          "remarks": {{ row.remarks | json }}
        }{% unless forloop.last %},{% endunless %}
{%- endfor %}
      ]
    }