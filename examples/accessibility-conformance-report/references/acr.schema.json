{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Accessibility conformance report, as JSON",
  "description": "The shape of acr.json, the machine-readable copy of the report this package renders. Every render validates the file against this schema before it writes anything. Each member holds the input value of the same name, and null where the inputs leave it out.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "product", "vendor", "date", "edition", "methods", "notes", "tables"],
  "properties": {
    "format": {
      "const": "metais-example-acr/1",
      "description": "Names this shape, so a program can tell it from another."
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] }
      }
    },
    "vendor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "contact", "email", "website"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "contact": { "type": ["string", "null"] },
        "email": { "type": ["string", "null"], "format": "email" },
        "website": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "date": { "type": "string", "format": "date" },
    "edition": { "enum": ["wcag", "section508", "en301549", "international"] },
    "methods": { "type": "string", "minLength": 1 },
    "notes": { "type": ["string", "null"] },
    "tables": {
      "description": "One table for each standard the edition answers, WCAG 2.2 first, then the Revised Section 508 Standards, then EN 301 549.",
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "prefixItems": [{ "properties": { "standard": { "const": "wcag" } } }],
      "items": { "$ref": "#/$defs/table" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "edition": { "const": "wcag" } } },
      "then": { "properties": { "tables": { "maxItems": 1 } } }
    },
    {
      "if": { "properties": { "edition": { "enum": ["section508", "en301549"] } } },
      "then": { "properties": { "tables": { "minItems": 2, "maxItems": 2, "prefixItems": [true, { "properties": { "standard": { "$ref": "#/properties/edition" } } }] } } }
    },
    {
      "if": { "properties": { "edition": { "const": "international" } } },
      "then": { "properties": { "tables": { "minItems": 3, "prefixItems": [true, { "properties": { "standard": { "const": "section508" } } }, { "properties": { "standard": { "const": "en301549" } } }] } } }
    }
  ],
  "$defs": {
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard", "criteria"],
      "properties": {
        "standard": { "enum": ["wcag", "section508", "en301549"] },
        "source": {
          "description": "The document the table's criterion numbers, names and levels are excerpts of, with the link, status and copyright notice its terms require on every copy. Only the WCAG 2.2 table holds it.",
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "url", "status", "notice"],
          "properties": {
            "title": { "const": "Web Content Accessibility Guidelines (WCAG) 2.2" },
            "url": { "const": "https://www.w3.org/TR/2024/REC-WCAG22-20241212/" },
            "status": { "const": "W3C Recommendation 12 December 2024" },
            "notice": { "const": "Copyright © 2020-2024 World Wide Web Consortium. W3C® liability, trademark and document use rules apply." }
          }
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/criterion" }
        }
      },
      "if": { "properties": { "standard": { "const": "wcag" } } },
      "then": { "required": ["source"], "properties": { "criteria": { "items": { "required": ["wcag_level"] } } } },
      "else": { "properties": { "source": false, "criteria": { "items": { "properties": { "wcag_level": false } } } } }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion", "label", "conformance", "remarks"],
      "properties": {
        "criterion": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)+$" },
        "label": { "type": "string", "minLength": 1 },
        "wcag_level": { "enum": ["A", "AA", "AAA"] },
        "conformance": { "enum": ["Supports", "Partially Supports", "Does Not Support", "Not Applicable", "Not Evaluated"] },
        "remarks": { "type": ["string", "null"] }
      }
    }
  }
}
