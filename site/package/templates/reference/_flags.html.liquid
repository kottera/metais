{%- comment -%}
  flags, a list of metais.help/1 flags, as a definition list: each flag's
  name, short alias and value, then its description, values, default, and
  whether it is required or repeatable.
{%- endcomment -%}
<dl class="flags">
{%- for f in flags %}
<dt id="flag{{ f.name | remove_first: "-" }}"><code>{% if f.short %}{{ f.short }}, {% endif %}{{ f.name }}{% if f.value %} {{ f.value }}{% endif %}</code></dt>
<dd>{{ f.description }}
{%- if f.values %} Values: {% for v in f.values %}<code>{{ v }}</code>{% unless forloop.last %}, {% endunless %}{% endfor %}.{% endif %}
{%- if f.default %} Default: <code>{{ f.default }}</code>.{% endif %}
{%- if f.required %} Required.{% endif %}
{%- if f.repeatable %} May be given more than once.{% endif %}</dd>
{%- endfor %}
</dl>
