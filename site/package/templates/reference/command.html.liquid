{%- comment -%}
  One command's page, item, from its declaration as metais help --json
  gives it (ADR-008 D15 items 1 and 3, A13): what metais help <command>
  prints, in the same order. Nothing but the layout is written here.
{%- endcomment -%}
{%- capture body -%}
<h1><code>metais {{ item.name }}</code></h1>
<p>{{ item.description }}</p>
<p>{{ item.group }}</p>

<h2 id="usage">Usage</h2>
<pre><code>{{ item.synopsis }}</code></pre>
{%- if item.examples.size > 0 %}

<h2 id="examples">Examples</h2>
<dl>
{%- for e in item.examples %}
<dt><pre><code>{{ e.run }}</code></pre></dt>
<dd>{{ e.why }}</dd>
{%- endfor %}
</dl>
{%- endif %}
{%- if item.detail != "" %}

<h2 id="detail">Detail</h2>
{%- render "reference/_paragraphs.html.liquid", text: item.detail -%}
{%- endif %}
{%- if item.operands.size > 0 %}

<h2 id="operands">Operands</h2>
<dl class="operands">
{%- for o in item.operands %}
<dt><code>{{ o.name }}</code></dt>
<dd>{{ o.description }}{% if o.required %} Required.{% endif %}{% if o.repeatable %} May be given more than once.{% endif %}</dd>
{%- endfor %}
</dl>
{%- endif %}

<h2 id="flags">Flags</h2>
{% render "reference/_flags.html.liquid", flags: item.flags %}

<h2 id="prints">Prints</h2>
<p>{{ item.prints }}</p>
{%- if item.format %}
<p>--json: <code>{{ item.format }}</code></p>
{%- endif %}

<h2 id="refusals">Refusals</h2>
{% render "reference/_refusals.html.liquid", refusals: item.refusals %}
{%- endcapture -%}
{%- assign title = "metais " | append: item.name | append: " — METAIS" -%}
{%- capture toc -%}
<li><a href="#usage">Usage</a></li>
{%- if item.examples.size > 0 %}
<li><a href="#examples">Examples</a></li>
{%- endif %}
{%- if item.detail != "" %}
<li><a href="#detail">Detail</a></li>
{%- endif %}
{%- if item.operands.size > 0 %}
<li><a href="#operands">Operands</a></li>
{%- endif %}
<li><a href="#flags">Flags</a></li>
<li><a href="#prints">Prints</a></li>
<li><a href="#refusals">Refusals</a></li>
{%- endcapture -%}
{%- assign here = "/reference/commands/" | append: item.name | append: "/" -%}
{%- capture side -%}{% render "reference/_side.html.liquid", here: here, toc: toc %}{%- endcapture -%}
{%- render "_layout.html.liquid", title: title, description: item.description, head: nil, body: body, section: "reference", kicker: "Reference · command", side: side -%}
