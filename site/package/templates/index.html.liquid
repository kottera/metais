<script>
/* Optional: copy buttons. Without JS the commands stay selectable text. */
(function(){
  if(!navigator.clipboard) return;
  document.querySelectorAll('.install .cmd, .line').forEach(function(row){
    var code=row.querySelector('code'); if(!code) return;
    var b=document.createElement('button'); b.className='copy'; b.type='button'; b.textContent='Copy';
    b.setAttribute('aria-label','Copy: '+code.textContent);
    b.addEventListener('click',function(){navigator.clipboard.writeText(code.textContent).then(function(){b.textContent='Copied';setTimeout(function(){b.textContent='Copy'},1400)})});
    row.appendChild(b);
  });
})();
</script>

