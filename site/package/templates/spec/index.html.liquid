{%- comment -%}
  /spec/, which leads to the latest released revision (ADR-011 A8 item 1):
  a redirect to its page. While no revision is released, there is none to
  lead to, so the page says so and links the draft, and, like the draft,
  asks search engines not to index it.
{%- endcomment -%}
{%- assign latest = inputs.spec.releases | last -%}
{%- capture head -%}
{%- if latest -%}
<meta http-equiv="refresh" content="0; url={{ latest.path }}">
<link rel="canonical" href="https://metais.org{{ latest.path }}">
{%- else -%}
<meta name="robots" content="noindex">
{%- endif -%}
{%- endcapture -%}
{%- capture body -%}
<h1>The METAIS specification</h1>
{%- if latest %}
<p>The latest revision is <a href="{{ latest.path }}">{{ latest.revision }}</a>.</p>
{%- else %}
<p>No revision of the specification is released yet. The draft is at <a href="{{ inputs.spec.draft.path }}">{{ inputs.spec.draft.path }}</a>.</p>
{%- endif %}
{%- endcapture -%}
{%- render "_layout.html.liquid", title: "The METAIS specification", description: nil, head: head, body: body, section: "spec", kicker: "Specification", side: nil -%}
