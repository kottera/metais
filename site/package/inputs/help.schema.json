{
  "$defs": {
    "command": {
      "type": "object",
      "required": [
        "name",
        "group",
        "synopsis",
        "description",
        "detail",
        "opens_package",
        "role",
        "operands",
        "flags",
        "format",
        "prints",
        "refusals",
        "examples"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "group": {
          "enum": [
            "Reading a package",
            "Supplying and rendering",
            "Authoring",
            "The tool"
          ]
        },
        "synopsis": {
          "type": "string",
          "pattern": "^metais "
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string"
        },
        "opens_package": {
          "description": "Whether the command opens a package. A command whose role is none opens none, and so does init, an authoring command that writes a new source directory.",
          "type": "boolean"
        },
        "role": {
          "description": "What the command is to a package (ADR-008 D13): consumer, authoring, or none for a command that is neither.",
          "enum": [
            "consumer",
            "authoring",
            "none"
          ]
        },
        "operands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "description",
              "required",
              "repeatable"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "repeatable": {
                "type": "boolean"
              }
            }
          }
        },
        "flags": {
          "description": "Every flag the command accepts, the global flags included.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/flag"
          }
        },
        "format": {
          "type": "string",
          "pattern": "^metais\\.[a-z][a-z0-9-]*/1$"
        },
        "prints": {
          "type": "string",
          "minLength": 1
        },
        "refusals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/refusal"
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/next"
          }
        }
      },
      "if": {
        "properties": {
          "role": {
            "const": "none"
          }
        }
      },
      "then": {
        "properties": {
          "opens_package": {
            "const": false
          }
        }
      }
    },
    "flag": {
      "type": "object",
      "required": [
        "name",
        "short",
        "value",
        "values",
        "default",
        "repeatable",
        "required",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "The flag's long spelling.",
          "type": "string",
          "pattern": "^--[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "short": {
          "description": "The one-letter alias, or null.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^-[A-Za-z]$"
            }
          ]
        },
        "value": {
          "description": "The placeholder of the flag's value, or null for a flag that takes none.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "values": {
          "description": "Every value the flag accepts, or null when it accepts any.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "default": {
          "description": "The value in force when the flag is absent, or null.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "repeatable": {
          "type": "boolean"
        },
        "required": {
          "description": "Whether the command refuses a line without the flag, as a missing operand.",
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "next": {
      "title": "A next step",
      "type": "object",
      "required": [
        "run",
        "why"
      ],
      "additionalProperties": false,
      "properties": {
        "run": {
          "description": "A complete metais command line; a value the tool cannot know or must not echo is a placeholder in angle brackets.",
          "type": "string",
          "pattern": "^metais( |$)"
        },
        "why": {
          "description": "One sentence saying what running it does.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "refusal": {
      "type": "object",
      "required": [
        "code",
        "cause",
        "next"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,3}$"
        },
        "cause": {
          "type": "string",
          "minLength": 1
        },
        "next": {
          "$ref": "#/$defs/next"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Generated from docs/cli/schemas by site/inputs_test.go's TestCLIResultSchemas; do not edit.",
  "properties": {
    "commands": {
      "items": {
        "$ref": "#/$defs/command"
      },
      "type": "array"
    },
    "description": {
      "minLength": 1,
      "type": "string"
    },
    "exit_codes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "maximum": 5,
            "minimum": 0,
            "type": "integer"
          },
          "meaning": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "code",
          "meaning"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "global_flags": {
      "description": "The flags accepted before a command's name.",
      "items": {
        "$ref": "#/$defs/flag"
      },
      "type": "array"
    },
    "paths": {
      "description": "The golden paths whose every command is declared.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "steps": {
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "title",
          "steps"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "refusals": {
      "description": "The refusals of a line before it names a command; listed with the overview only.",
      "items": {
        "$ref": "#/$defs/refusal"
      },
      "type": "array"
    },
    "topics": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "type": "string"
          },
          "text": {
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name",
          "title",
          "text"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "usage": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "description",
    "usage",
    "paths",
    "commands",
    "global_flags",
    "refusals",
    "topics",
    "exit_codes"
  ],
  "title": "The result of a metais.help/1 document",
  "type": "object"
}
