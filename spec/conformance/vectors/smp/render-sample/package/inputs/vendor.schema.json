{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "kind"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "kind": {
      "enum": [
        "person",
        "company"
      ]
    },
    "registration": {
      "type": "string",
      "pattern": "^[A-Z]{2}[0-9]{6}$"
    },
    "rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "email": {
      "type": "string",
      "format": "email"
    }
  },
  "if": {
    "properties": {
      "kind": {
        "const": "company"
      }
    },
    "required": [
      "kind"
    ]
  },
  "then": {
    "required": [
      "registration"
    ],
    "properties": {
      "registration": {
        "minLength": 8
      }
    }
  }
}
