            "items": 9,
            "seed": 3
          },
          "expect": {
            "ok": true,
            "trees": [
              {
                "path": "out",
                "equals": "expected/exhausted"
              }
            ]
          },
          "repeatable": true
        },
        {
          "op": "validate",
          "args": {
            "package": "package",
            "data": "out"
          },
          "expect": {
            "ok": true
          }
        }
      ]
    }
  ]
