        },
        {
          "op": "validate",
          "args": {
            "package": "package",
            "data": "out"
          },
          "expect": {
            "ok": true
          }
        }
      ]
    },
    {
      "name": "exhausted",
      "steps": [
        {
          "op": "sample",
          "args": {
            "source": "package",
