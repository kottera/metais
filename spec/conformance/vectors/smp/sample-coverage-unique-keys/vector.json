{
  "$schema": "https://metais.org/schemas/conformance/1/vector.schema.json",
  "id": "smp/sample-coverage-unique-keys",
  "title": "Sample honours coverage and uniqueKeys on one column: the covered items first, every key distinct, the array no longer than the distinct keys, and a render with sample renders it",
  "statements": [
    "MTS-SMP-009",
    "MTS-SMP-010",
    "MTS-SMP-011"
  ],
  "since": "1.0",
  "class": "authoring",
  "tags": [],
  "requires": [],
  "notes": "",
  "cases": [
    {
      "name": "items-below",
      "steps": [
        {
          "op": "sample",
          "args": {
            "source": "package",
            "to": "out",
            "items": 1
          },
          "expect": {
            "ok": true,
            "trees": [
              {
                "path": "out",
                "equals": "expected/items-below"
              }
            ]
          },
          "repeatable": true
        },
        {
          "op": "validate",
          "args": {
            "package": "package",
            "data": "out"
          },
          "expect": {
            "ok": true
          }
        }
      ]
    },
    {
      "name": "items-above-keys",
      "steps": [
        {
          "op": "sample",
          "args": {
            "source": "package",
            "to": "out",
            "items": 8
          },
          "expect": {
            "ok": true,
            "trees": [
              {
                "path": "out",
                "equals": "expected/items-above-keys"
              }
            ]
          },
          "repeatable": true
        },
        {
          "op": "validate",
          "args": {
            "package": "package",
            "data": "out"
          },
          "expect": {
            "ok": true
          }
        }
      ]
    },
    {
      "name": "render",
      "steps": [
        {
          "op": "render",
          "args": {
            "package": "package",
            "out": "out",
            "sample": {
              "items": 4
            }
          },
          "expect": {
            "ok": true,
            "trees": [
              {
                "path": "out",
                "equals": "expected/report"
              }
            ]
          }
        }
      ]
    }
  ]
}
