{
  "$schema": "https://metais.org/schemas/conformance/1/vector.schema.json",
  "id": "smp/sample-coverage",
  "title": "Sample generates one item per member of coverage's values, in values' order and first, whatever items asks, then fills up to items",
  "statements": [
    "MTS-SMP-010"
  ],
  "since": "1.0",
  "class": "authoring",
  "tags": [],
  "requires": [],
  "notes": "",
  "cases": [
    {
      "name": "items-below",
      "steps": [
        {
          "op": "sample",
          "args": {
            "source": "package",
            "to": "out",
            "items": 1
          },
          "expect": {
            "ok": true,
            "trees": [
              {
                "path": "out",
                "equals": "expected/items-below"
              }
            ]
          },
          "repeatable": true
        },
        {
          "op": "validate",
          "args": {
            "package": "package",
            "data": "out"
          },
          "expect": {
            "ok": true
          }
        }
      ]
    },
    {
