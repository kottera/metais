{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["sku", "qty"],
    "properties": {
      "sku": { "type": "string", "pattern": "^[a-z]{2}[0-9]{2}$" },
      "qty": { "type": "integer", "minimum": 1, "maximum": 99 },
      "price": { "type": "number", "minimum": 0, "multipleOf": 0.01 }
    }
  }
}
