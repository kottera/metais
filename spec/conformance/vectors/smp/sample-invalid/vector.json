          "op": "sample",
          "args": {
            "source": "package",
            "to": "out",
            "set_json": [
              "/summary=\"Too short\"",
              "/vendor/kind=\"robot\""
            ]
          },
          "expect": {
            "ok": false,
            "findings": "expected/set-json.json"
          },
          "repeatable": true
        }
      ]
    }
