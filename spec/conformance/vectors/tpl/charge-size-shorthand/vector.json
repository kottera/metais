{
  "$schema": "https://metais.org/schemas/conformance/1/vector.schema.json",
  "id": "tpl/charge-size-shorthand",
  "title": "A string's size shorthand is charged a unit for each byte of the string",
  "statements": [
    "MTS-TPL-063",
    "MTS-SEC-008"
  ],
  "since": "1.0",
  "class": "processor",
  "tags": [
    "limits"
  ],
  "requires": [],
  "notes": "16 for the assign, 16 for the output, and 6 for the bytes of \"héllo\", whose size is 5 characters: 38.",
  "cases": [
    {
      "name": "at-the-bound",
      "steps": [
        {
          "op": "render",
          "args": {
            "package": "package",
            "out": "out",
            "limits": {
              "render-work": 38
            }
          },
          "expect": {
            "ok": true,
            "trees": [
              {
                "path": "out",
                "equals": "expected/at-the-bound-out"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "one-below",
      "steps": [
        {
          "op": "render",
          "args": {
            "package": "package",
            "out": "out",
            "limits": {
              "render-work": 37
            }
          },
          "expect": {
            "ok": false,
            "findings": "expected/one-below.json"
          }
        }
      ]
    }
  ]
}
