{
  "$schema": "https://metais.org/schemas/conformance/1/vector.schema.json",
  "id": "tpl/fan-out-file-names",
  "title": "One output per collection item is named after the item's file through sources.<name>[fan_out.index0].stem, its index counted before when drops a draft",
  "statements": [
    "MTS-TPL-057",
    "MTS-TPL-038",
    "MTS-OUT-008"
  ],
  "since": "1.0",
  "class": "processor",
  "tags": [],
  "requires": [],
  "notes": "",
  "cases": [
    {
      "name": "render",
      "steps": [
        {
          "op": "render",
          "args": {
            "package": "package",
            "out": "out",
            "data": "data"
          },
          "expect": {
            "ok": true,
            "trees": [
              {
                "path": "out",
                "equals": "expected/render-out"
              }
            ]
          }
        }
      ]
    }
  ]
}
