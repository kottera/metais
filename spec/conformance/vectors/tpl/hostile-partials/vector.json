{
  "$schema": "https://metais.org/schemas/conformance/1/vector.schema.json",
  "id": "tpl/hostile-partials",
  "title": "A template that includes, renders a partial from outside the package's templates or from the host, names an asset outside assets/, or recurses without end is refused at its render step, and nothing is written",
  "statements": [
    "MTS-TPL-042",
    "MTS-TPL-002",
    "MTS-TPL-043",
    "MTS-TPL-046",
    "MTS-TAG-013"
  ],
  "since": "1.0",
  "class": "processor",
  "tags": [
    "security"
  ],
  "requires": [],
  "notes": "ADR-009 D17 item 7, one defect per package. render-decoy's work directory holds decoy.liquid and templates/decoy.liquid beside the package, which the partial must not be read from; render-compiled and render-asset name entries of the package that are not templates. The recursive cases are refused at the default partial-depth, which costs 33 nested renders.",
  "cases": [
    {
      "name": "include",
      "steps": [
        {
          "op": "render",
          "args": {
            "package": "include",
            "out": "out"
          },
          "expect": {
            "ok": false,
            "findings": "expected/include.json"
          },
          "bounds": {
            "cpu_ms": 1000,
            "rss_mib": 64
          }
        }
      ]
    },
    {
