  "statements": [
    "MTS-TAG-003",
    "MTS-TAG-004"
  ],
  "since": "1.0",
  "class": "processor",
  "tags": [],
  "requires": [],
  "notes": "",
  "cases": [
    {
      "name": "render",
      "steps": [
        {
          "op": "render",
          "args": {
            "package": "package",
            "data": "data",
            "out": "out"
          },
          "expect": {
            "ok": true,
            "trees": [
              {
                "path": "out",
                "equals": "expected/out"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "set-json",
      "steps": [
        {
          "op": "render",
          "args": {
            "package": "package",
            "data": "data",
            "out": "out",
            "set_json": [
              "/snippets/1=\"z\""
            ]
          },
          "expect": {
            "ok": false,
            "findings": "expected/set-json.json"
          }
        }
      ]
    }
  ]
