{
  "$schema": "https://metais.org/schemas/conformance/1/vector.schema.json",
  "id": "sec/assign-bytes-filter-built",
  "title": "assign-bytes counts the bytes assign stores of a string a filter builds, once, and nothing for a string a filter builds that is written, or an ifchanged body",
  "statements": [
    "MTS-SEC-009"
  ],
  "since": "1.0",
  "class": "processor",
  "tags": [
    "limits"
  ],
  "requires": [],
  "notes": "The assign stores \"abcd\", 4 bytes. The append it applies, the append written, and the ifchanged body store nothing.",
  "cases": [
    {
      "name": "at-the-limit",
      "steps": [
        {
          "op": "render",
          "args": {
            "package": "package",
            "out": "out",
            "limits": {
              "assign-bytes": 4
            }
          },
          "expect": {
            "ok": true,
            "trees": [
              {
                "path": "out",
                "equals": "expected/at-the-limit-out"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "beyond-the-limit",
      "steps": [
        {
          "op": "render",
          "args": {
            "package": "package",
            "out": "out",
            "limits": {
              "assign-bytes": 3
            }
          },
          "expect": {
            "ok": false,
            "findings": "expected/beyond-the-limit.json"
          }
        }
      ]
    }
  ]
}
