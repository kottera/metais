{
  "$schema": "https://metais.org/schemas/conformance/1/vector.schema.json",
  "id": "sec/entries-packed",
  "title": "A packed package of as many entries as a lowered entries limit is accepted, and one entry past it is refused",
  "statements": [
    "MTS-SEC-001"
  ],
  "since": "1.0",
  "class": "processor",
  "tags": [
    "security",
    "byte-level",
    "limits"
  ],
  "requires": [],
  "notes": "Its package.metais is written by internal/vectorgen (go test ./internal/vectorgen -run TestPackages -args -update), whose test reproduces the committed bytes.",
  "cases": [
    {
      "name": "at-bound",
      "steps": [
        {
          "op": "validate",
          "args": {
            "package": "package.metais",
            "set": [
              "/report/title=Hostile"
            ],
            "limits": {
              "entries": 7
            }
          },
          "expect": {
            "ok": true
          },
          "bounds": {
            "cpu_ms": 500,
            "rss_mib": 64
          }
        }
      ]
    },
    {
      "name": "past-bound",
      "steps": [
        {
          "op": "open",
          "args": {
            "package": "package.metais",
            "limits": {
              "entries": 6
            }
          },
          "expect": {
            "ok": false,
            "findings": "expected/findings.json"
          },
          "bounds": {
            "cpu_ms": 500,
            "rss_mib": 64
          }
        }
      ]
    }
  ]
}
