{
  "$schema": "https://metais.org/schemas/conformance/1/vector.schema.json",
  "id": "sec/data-limits",
  "title": "Every data limit is enforced on the inputs of one command, each breach limit.exceeded about the input",
  "statements": [
    "MTS-SEC-005"
  ],
  "since": "1.0",
  "class": "processor",
  "tags": [
    "limits"
  ],
  "requires": [],
  "notes": "",
  "cases": [
    {
      "name": "lowered",
      "steps": [
        {
          "op": "validate",
          "args": {
            "package": "package",
            "data": "data/lowered-1",
            "limits": {
              "input-size": 96,
              "csv-rows": 2,
              "csv-columns": 2,
              "csv-cell": 8,
              "frontmatter-size": 16,
              "value-depth": 5,
              "number-length": 8
            }
          },
          "expect": {
            "ok": false,
            "findings": "expected/lowered-1.json"
          }
        },
        {
          "op": "validate",
          "args": {
            "package": "package",
            "data": "data/lowered-2",
            "limits": {
              "inputs-total": 40
            }
          },
          "expect": {
            "ok": false,
            "findings": "expected/lowered-2.json"
          }
        },
        {
          "op": "validate",
          "args": {
            "package": "package",
            "data": "data/lowered-3",
            "limits": {
              "collection-items": 2
            }
          },
          "expect": {
            "ok": false,
            "findings": "expected/lowered-3.json"
          }
        }
      ]
    }
  ]
}
