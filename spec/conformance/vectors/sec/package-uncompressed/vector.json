{
  "$schema": "https://metais.org/schemas/conformance/1/vector.schema.json",
  "id": "sec/package-uncompressed",
  "title": "Entries whose sizes sum to a lowered package-uncompressed are accepted, and one byte past it are refused",
  "statements": [
    "MTS-SEC-001"
  ],
  "since": "1.0",
  "class": "processor",
  "tags": [
    "security",
    "byte-level",
    "limits"
  ],
  "requires": [],
  "notes": "Its package.metais is written by internal/vectorgen (go test ./internal/vectorgen -run TestPackages -args -update), whose test reproduces the committed bytes.",
  "cases": [
    {
      "name": "at-bound",
      "steps": [
        {
          "op": "validate",
          "args": {
            "package": "package.metais",
            "set": [
              "/report/title=Hostile"
            ],
            "limits": {
              "package-uncompressed": 6889
            }
          },
          "expect": {
            "ok": true
          },
          "bounds": {
            "cpu_ms": 500,
            "rss_mib": 64
          }
        }
      ]
    },
    {
      "name": "past-bound",
      "steps": [
        {
          "op": "open",
          "args": {
            "package": "package.metais",
            "limits": {
              "package-uncompressed": 6888
            }
          },
          "expect": {
            "ok": false,
            "findings": "expected/findings.json"
          },
          "bounds": {
            "cpu_ms": 500,
            "rss_mib": 64
          }
        }
      ]
    }
  ]
}
