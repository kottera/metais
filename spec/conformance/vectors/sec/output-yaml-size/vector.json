{
  "$schema": "https://metais.org/schemas/conformance/1/vector.schema.json",
  "id": "sec/output-yaml-size",
  "title": "A validated YAML output of yaml-size bytes is validated, and one of a byte more is refused before it is parsed",
  "statements": [
    "MTS-SEC-062"
  ],
  "since": "1.0",
  "class": "processor",
  "tags": [
    "security",
    "limits"
  ],
  "requires": [],
  "notes": "b.yaml is 12 bytes.",
  "cases": [
    {
      "name": "at-the-limit",
      "steps": [
        {
          "op": "render",
          "args": {
            "package": "package",
            "out": "out",
            "limits": {
              "yaml-size": 12
            }
          },
          "expect": {
            "ok": true,
            "trees": [
              {
                "path": "out",
                "equals": "expected/at-the-limit-out"
              }
            ]
          },
          "bounds": {
            "cpu_ms": 500,
            "rss_mib": 64
          }
        }
      ]
    },
    {
      "name": "beyond-the-limit",
      "steps": [
        {
          "op": "render",
          "args": {
            "package": "package",
            "out": "out",
            "limits": {
              "yaml-size": 11
            }
          },
          "expect": {
            "ok": false,
            "findings": "expected/beyond-the-limit.json"
          },
          "bounds": {
            "cpu_ms": 500,
            "rss_mib": 64
          }
        }
      ]
    }
  ]
}
