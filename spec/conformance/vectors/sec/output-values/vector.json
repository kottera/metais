{
  "$schema": "https://metais.org/schemas/conformance/1/vector.schema.json",
  "id": "sec/output-values",
  "title": "The values of each validated output, JSON or YAML, are counted against output-values apart from every other output's: at the bound each is validated, and one value past it is refused",
  "statements": [
    "MTS-SEC-063"
  ],
  "since": "1.0",
  "class": "processor",
  "tags": [
    "security",
    "limits"
  ],
  "requires": [],
  "notes": "a.json and b.yaml each decode to 4 values, an array and three numbers, so a bound of 4 holds both, which together decode to 8.",
  "cases": [
    {
      "name": "at-the-limit",
      "steps": [
        {
          "op": "render",
          "args": {
            "package": "package",
            "out": "out",
            "limits": {
              "output-values": 4
            }
          },
          "expect": {
            "ok": true,
            "trees": [
              {
                "path": "out",
                "equals": "expected/at-the-limit-out"
              }
            ]
          },
          "bounds": {
            "cpu_ms": 500,
            "rss_mib": 64
          }
        }
      ]
    },
    {
      "name": "beyond-the-limit",
      "steps": [
        {
          "op": "render",
          "args": {
            "package": "package",
            "out": "out",
            "limits": {
              "output-values": 3
            }
          },
          "expect": {
            "ok": false,
            "findings": "expected/beyond-the-limit.json"
          },
          "bounds": {
            "cpu_ms": 500,
            "rss_mib": 64
          }
        }
      ]
    }
  ]
}
