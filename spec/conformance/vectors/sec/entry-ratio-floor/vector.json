{
  "$schema": "https://metais.org/schemas/conformance/1/vector.schema.json",
  "id": "sec/entry-ratio-floor",
  "title": "An entry of exactly 1 MiB compressed far beyond entry-ratio is accepted: the ratio bounds only an entry larger than 1 MiB",
  "statements": [
    "MTS-SEC-001"
  ],
  "since": "1.0",
  "class": "processor",
  "tags": [
    "byte-level",
    "limits"
  ],
  "requires": [],
  "notes": "Its package.metais is written by internal/vectorgen (go test ./internal/vectorgen -run TestPackages -args -update), whose test reproduces the committed bytes.",
  "cases": [
    {
      "name": "at-floor",
      "steps": [
        {
          "op": "validate",
          "args": {
            "package": "package.metais",
            "set": [
              "/report/title=Hostile"
            ]
          },
          "expect": {
            "ok": true
          },
          "bounds": {
            "cpu_ms": 500,
            "rss_mib": 64
          }
        }
      ]
    }
  ]
}
