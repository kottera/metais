{
  "$schema": "https://metais.org/schemas/conformance/1/vector.schema.json",
  "id": "sec/regex-program",
  "title": "A pattern of as many instructions as regex-program is accepted, and one past it is refused",
  "statements": [
    "MTS-SEC-042"
  ],
  "since": "1.0",
  "class": "processor",
  "tags": [
    "security",
    "limits"
  ],
  "requires": [],
  "notes": "a{1000}a{1000}a{1000}a{1000}a{94} compiles to 4,096 instructions and a{95} in its place to 4,097; each pattern is 36 bytes.",
  "cases": [
    {
      "name": "at-the-limit",
      "steps": [
        {
          "op": "validate",
          "args": {
            "package": "package",
            "set_json": [
              "/report={}"
            ]
          },
          "expect": {
            "ok": true
          },
          "bounds": {
            "cpu_ms": 500,
            "rss_mib": 64
          }
        }
      ]
    },
    {
      "name": "beyond-the-limit",
      "steps": [
        {
          "op": "open",
          "args": {
            "package": "beyond"
          },
          "expect": {
            "ok": false,
            "findings": "expected/findings.json"
          },
          "bounds": {
            "cpu_ms": 500,
            "rss_mib": 64
          }
        }
      ]
    }
  ]
}
