{
  "$schema": "https://metais.org/schemas/conformance/1/vector.schema.json",
  "id": "sec/schema-value-depth",
  "title": "value-depth bounds a schema file's nesting: a schema exactly as deep as the bound opens, and one level more is refused",
  "statements": [
    "MTS-SEC-001",
    "MTS-SEC-035"
  ],
  "since": "1.0",
  "class": "processor",
  "tags": [
    "limits"
  ],
  "requires": [],
  "notes": "",
  "cases": [
    {
      "name": "at-the-limit",
      "steps": [
        {
          "op": "open",
          "args": {
            "package": "package",
            "limits": {
              "value-depth": 4
            }
          },
          "expect": {
            "ok": true
          }
        }
      ]
    },
    {
      "name": "beyond-the-limit",
      "steps": [
        {
          "op": "open",
          "args": {
            "package": "package",
            "limits": {
              "value-depth": 3
            }
          },
          "expect": {
            "ok": false,
            "findings": "expected/beyond-the-limit.json"
          }
        }
      ]
    }
  ]
}
