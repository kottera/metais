{
  "$schema": "https://metais.org/schemas/conformance/1/vector.schema.json",
  "id": "sec/manifest-size-bound",
  "title": "manifest-size bounds metais.yaml: a manifest of exactly the bound opens, and one byte over is refused",
  "statements": [
    "MTS-SEC-001"
  ],
  "since": "1.0",
  "class": "processor",
  "tags": [
    "limits"
  ],
  "requires": [],
  "notes": "",
  "cases": [
    {
      "name": "at-the-limit",
      "steps": [
        {
          "op": "open",
          "args": {
            "package": "package",
            "limits": {
              "manifest-size": 263
            }
          },
          "expect": {
            "ok": true
          }
        }
      ]
    },
    {
      "name": "beyond-the-limit",
      "steps": [
        {
          "op": "open",
          "args": {
            "package": "package",
            "limits": {
              "manifest-size": 262
            }
          },
          "expect": {
            "ok": false,
            "findings": "expected/beyond-the-limit.json"
          }
        }
      ]
    }
  ]
}
