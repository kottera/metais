{
  "$schema": "https://metais.org/schemas/conformance/1/vector.schema.json",
  "id": "sec/pattern-length",
  "title": "A pattern as long as pattern-length is accepted, and one byte past it is refused",
  "statements": [
    "MTS-SEC-042"
  ],
  "since": "1.0",
  "class": "processor",
  "tags": [
    "security",
    "limits"
  ],
  "requires": [],
  "notes": "Each pattern is one character class of the letter a, a program of a few instructions, so only pattern-length refuses it. Its generated files are written by internal/vectorgen (go test ./internal/vectorgen -run TestSchemaCorpus -args -update), whose test reproduces them.",
  "cases": [
    {
      "name": "at-the-limit",
      "steps": [
        {
          "op": "validate",
          "args": {
            "package": "package",
            "set_json": [
              "/report={}"
            ]
          },
          "expect": {
            "ok": true
          },
          "bounds": {
            "cpu_ms": 500,
            "rss_mib": 64
          }
        }
      ]
    },
    {
      "name": "beyond-the-limit",
      "steps": [
        {
          "op": "open",
          "args": {
            "package": "beyond"
          },
          "expect": {
            "ok": false,
            "findings": "expected/findings.json"
          },
          "bounds": {
            "cpu_ms": 500,
            "rss_mib": 64
          }
        }
      ]
    }
  ]
}
