{
  "$schema": "https://metais.org/schemas/conformance/1/vector.schema.json",
  "id": "sec/data-limits-bound",
  "title": "Each data limit and the findings limit admits an input exactly at its bound and refuses, or for findings truncates, one past it",
  "statements": [
    "MTS-SEC-058",
    "MTS-SEC-005",
    "MTS-FND-010"
  ],
  "since": "1.0",
  "class": "processor",
  "tags": [
    "limits"
  ],
  "requires": [],
  "notes": "",
  "cases": [
    {
      "name": "input-size",
      "steps": [
        {
          "op": "validate",
          "args": {
            "package": "package",
            "data": "data/input-size-at",
            "limits": {
              "input-size": 16
            }
          },
          "expect": {
            "ok": true
          }
        },
        {
          "op": "validate",
          "args": {
            "package": "package",
            "data": "data/input-size-past",
            "limits": {
              "input-size": 16
            }
          },
          "expect": {
            "ok": false,
            "findings": "expected/input-size-past.json"
          }
        }
      ]
    },
