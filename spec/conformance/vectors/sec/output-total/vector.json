{
  "$schema": "https://metais.org/schemas/conformance/1/vector.schema.json",
  "id": "sec/output-total",
  "title": "output-total bounds every byte a render writes, and refuses the output that takes the total beyond it",
  "statements": [
    "MTS-SEC-010"
  ],
  "since": "1.0",
  "class": "processor",
  "tags": [
    "limits"
  ],
  "requires": [],
  "notes": "",
  "cases": [
    {
      "name": "at-the-limit",
      "steps": [
        {
          "op": "render",
          "args": {
            "package": "package",
            "out": "out",
            "limits": {
              "output-total": 10
            }
          },
          "expect": {
            "ok": true,
            "trees": [
              {
                "path": "out",
                "equals": "expected/at-the-limit-out"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "beyond-the-limit",
      "steps": [
        {
          "op": "render",
          "args": {
            "package": "package",
            "out": "out",
            "limits": {
              "output-total": 9
            }
          },
          "expect": {
            "ok": false,
            "findings": "expected/beyond-the-limit.json"
          }
        }
      ]
    }
  ]
}
