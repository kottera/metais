{
  "$schema": "https://metais.org/schemas/conformance/1/vector.schema.json",
  "id": "out/mirror",
  "title": "A mirror renders every template beneath its directory to the same relative path with .liquid removed, but partials and templates a template output names",
  "statements": [
    "MTS-OUT-016",
    "MTS-OUT-017"
  ],
  "since": "1.0",
  "class": "processor",
  "tags": [
    "determinism"
  ],
  "requires": [],
  "notes": "",
  "cases": [
    {
      "name": "render",
      "steps": [
        {
          "op": "render",
          "args": {
            "package": "package",
            "out": "out"
          },
          "expect": {
            "ok": true,
            "trees": [
              {
                "path": "out",
                "equals": "expected/out"
              }
            ]
          }
        }
      ]
    }
  ]
}
