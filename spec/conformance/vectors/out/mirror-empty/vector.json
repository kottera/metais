{
  "$schema": "https://metais.org/schemas/conformance/1/vector.schema.json",
  "id": "out/mirror-empty",
  "title": "A mirror that renders no file is a warning: the render still writes, and asked to fail on warnings it fails and writes nothing",
  "statements": [
    "MTS-OUT-019",
    "MTS-RND-007"
  ],
  "since": "1.0",
  "class": "processor",
  "tags": [],
  "requires": [],
  "notes": "",
  "cases": [
    {
      "name": "render",
      "steps": [
        {
          "op": "render",
          "args": {
            "package": "package",
            "out": "out"
          },
          "expect": {
            "ok": true,
            "findings": "expected/findings.json",
            "trees": [
              {
                "path": "out",
                "equals": "expected/out"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "fail-on-warning",
      "steps": [
        {
          "op": "render",
          "args": {
            "package": "package",
            "out": "out",
            "fail_on": "warning"
          },
          "expect": {
            "ok": false,
            "findings": "expected/findings.json"
          }
        }
      ]
    }
  ]
}
