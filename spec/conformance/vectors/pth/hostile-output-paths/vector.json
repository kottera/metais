{
  "$schema": "https://metais.org/schemas/conformance/1/vector.schema.json",
  "id": "pth/hostile-output-paths",
  "title": "An output path the manifest writes in a Windows-invalid form, with a reserved name, a control or bidirectional character, or a .git segment is refused at its render step, and nothing is written",
  "statements": [
    "MTS-PTH-003",
    "MTS-PTH-004",
    "MTS-PTH-005",
    "MTS-PTH-010",
    "MTS-SEC-012"
  ],
  "since": "1.0",
  "class": "processor",
  "tags": [
    "security",
    "portable-paths"
  ],
  "requires": [],
  "notes": "ADR-009 D17 item 8 and ADR-005's path cases, one defect per package: each manifest declares one output, at the path its case is named for. Traversal and absolute manifest paths are pth/output-path-traversal's.",
