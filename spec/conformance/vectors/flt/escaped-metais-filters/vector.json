{
  "$schema": "https://metais.org/schemas/conformance/1/vector.schema.json",
  "id": "flt/escaped-metais-filters",
  "title": "In an output whose escape is html, a METAIS filter's result is escaped unless the last filter marks it safe",
  "statements": [
    "MTS-FLT-005",
    "MTS-FLT-006",
    "MTS-FLT-007",
    "MTS-FLT-008",
    "MTS-FLT-010",
    "MTS-FLT-012",
    "MTS-TPL-059",
    "MTS-TPL-060"
  ],
  "since": "1.0",
  "class": "processor",
  "tags": [
    "security"
  ],
  "requires": [],
  "notes": "The meeting of W5-1's filters with W5-2's escaping.",
  "cases": [
    {
      "name": "render",
      "steps": [
        {
          "op": "render",
          "args": {
            "package": "package",
            "out": "out",
            "data": "data"
          },
          "expect": {
            "ok": true,
            "trees": [
              {
                "path": "out",
                "equals": "expected/out"
              }
            ]
          }
        }
      ]
    }
  ]
