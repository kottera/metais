{
  "$schema": "https://metais.org/schemas/conformance/1/vector.schema.json",
  "id": "rnd/stream-container",
  "title": "A container output is listed by a dry run with its entries, is one archive entry holding the zip a directory render writes, and is selected whole by its path",
  "statements": [
    "MTS-RND-009",
    "MTS-RND-010",
    "MTS-RND-012"
  ],
  "since": "1.0",
  "class": "processor",
  "tags": [],
  "requires": [],
  "notes": "The meeting of W5-9 with W5-6. Every entry is stored, so the container's bytes are fixed and its size, digest and archive entry compare exactly.",
  "cases": [
    {
      "name": "dry-run",
      "steps": [
        {
          "op": "render",
          "args": {
            "package": "package",
            "out": "out",
            "dry_run": true
          },
          "expect": {
            "ok": true,
            "listing": "expected/listing.json"
          }
        }
      ]
    },
    {
      "name": "archive",
      "steps": [
        {
          "op": "render",
          "args": {
            "package": "package",
            "stream": "archive"
          },
          "expect": {
            "ok": true,
            "stream": {
              "equals": "expected/stream.tar"
            }
          }
        }
      ]
    },
    {
      "name": "only",
      "steps": [
        {
          "op": "render",
          "args": {
            "package": "package",
            "stream": {
              "only": "box.zip"
            }
          },
          "expect": {
            "ok": true,
            "stream": {
              "equals": "expected/box.zip",
              "container": {
                "methods": "all"
              }
            }
          }
        }
      ]
    }
  ]
}
