{
  "$schema": "https://metais.org/schemas/conformance/1/vector.schema.json",
  "id": "rnd/existing-empty",
  "title": "A render into an existing directory with no entry at all writes into it, with no request to replace files",
  "statements": [
    "MTS-RND-013",
    "MTS-RND-014"
  ],
  "since": "1.0",
  "class": "processor",
  "tags": [],
  "requires": [],
  "notes": "",
  "cases": [
    {
      "name": "empty",
      "setup": {
        "dirs": [
          "out"
        ]
      },
      "steps": [
        {
          "op": "render",
          "args": {
            "package": "package",
            "out": "out"
          },
          "expect": {
            "ok": true,
            "trees": [
              {
                "path": "out",
                "equals": "expected/out"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "empty-with-overwrite",
      "setup": {
        "dirs": [
          "out"
        ]
      },
      "steps": [
        {
          "op": "render",
          "args": {
            "package": "package",
            "out": "out",
            "overwrite": true
          },
          "expect": {
            "ok": true,
            "trees": [
              {
                "path": "out",
                "equals": "expected/out"
              }
            ]
          }
        }
      ]
    }
  ]
}
