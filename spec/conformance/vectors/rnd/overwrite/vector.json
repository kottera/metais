{
  "$schema": "https://metais.org/schemas/conformance/1/vector.schema.json",
  "id": "rnd/overwrite",
  "title": "A render into a directory that holds entries is refused without the request to replace files, and with it replaces each file it writes, by rename, and leaves every other file alone",
  "statements": [
    "MTS-RND-004",
    "MTS-RND-014",
    "MTS-RND-020",
    "MTS-RND-021"
  ],
  "since": "1.0",
  "class": "processor",
  "tags": [],
  "requires": [],
  "notes": "same.txt already holds the bytes the render writes, and is replaced all the same; keep.txt, sub/keep.txt and .DS_Store are not the render's, and are left as they were.",
  "cases": [
    {
      "name": "without-overwrite",
      "setup": {
        "copy": "setup"
      },
      "steps": [
        {
          "op": "render",
          "args": {
            "package": "package",
            "out": "out"
          },
          "expect": {
            "ok": false,
            "findings": "expected/without-overwrite.json"
          }
        }
      ]
    },
    {
      "name": "with-overwrite",
      "setup": {
        "copy": "setup"
      },
      "steps": [
        {
          "op": "render",
          "args": {
            "package": "package",
            "out": "out",
            "overwrite": true
          },
          "expect": {
            "ok": true,
            "trees": [
              {
                "path": "out",
                "equals": "expected/out"
              }
            ]
          }
        }
      ]
    }
  ]
}
