{
  "$schema": "https://metais.org/schemas/conformance/1/vector.schema.json",
  "id": "trn/container-provenance",
  "title": "provenance in a container's entry writes in the style of that entry's kind, by its path or its kind, and a csv entry without style: is refused at the container's path and its own",
  "statements": [
    "MTS-TAG-009",
    "MTS-TAG-010",
    "MTS-TRN-001"
  ],
  "since": "1.0",
  "class": "processor",
  "tags": [],
  "requires": [],
  "notes": "",
  "cases": [
    {
      "name": "render",
      "steps": [
        {
          "op": "render",
          "args": {
            "package": "package",
            "out": "out"
          },
          "expect": {
            "ok": true,
            "trees": [
              {
                "path": "out",
                "equals": "expected/out",
                "containers": [
                  {
                    "path": "box.zip",
                    "methods": []
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "name": "refused",
      "steps": [
        {
          "op": "render",
          "args": {
            "package": "refused",
            "out": "out"
          },
          "expect": {
            "ok": false,
            "findings": "expected/refused.json"
          }
        }
      ]
    }
  ]
}
