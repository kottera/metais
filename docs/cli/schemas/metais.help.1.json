{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metais.org/cli/schemas/metais.help.1.json",
  "title": "metais.help/1",
  "description": "What metais help, metais --help and metais <command> --help print with --json: the overview's members, and every command's full declaration and every topic, or only the command or topic asked for (ADR-008 D15 item 5).",
  "$ref": "metais.envelope.1.json",
  "properties": {
    "format": {
      "const": "metais.help/1"
    },
    "result": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/result"
        }
      ]
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "required": [
        "description",
        "usage",
        "paths",
        "commands",
        "global_flags",
        "refusals",
        "topics",
        "exit_codes"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "usage": {
          "type": "string",
          "minLength": 1
        },
        "paths": {
          "description": "The golden paths whose every command is declared.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "steps"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "steps": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "global_flags": {
          "description": "The flags accepted before a command's name.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/flag"
          }
        },
        "refusals": {
          "description": "The refusals of a line before it names a command; listed with the overview only.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/refusal"
          }
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "title",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "exit_codes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "meaning"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              "meaning": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "command": {
      "type": "object",
      "required": [
        "name",
        "group",
        "synopsis",
        "description",
        "detail",
        "opens_package",
        "role",
        "operands",
        "flags",
        "format",
        "prints",
        "refusals",
        "examples"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "group": {
          "enum": [
            "Reading a package",
            "Supplying and rendering",
            "Authoring",
            "The tool"
          ]
        },
        "synopsis": {
          "type": "string",
          "pattern": "^metais "
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string"
        },
        "opens_package": {
          "description": "Whether the command opens a package. A command whose role is none opens none, and so does init, an authoring command that writes a new source directory.",
          "type": "boolean"
        },
        "role": {
          "description": "What the command is to a package (ADR-008 D13): consumer, authoring, or none for a command that is neither.",
          "enum": [
            "consumer",
            "authoring",
            "none"
          ]
        },
        "operands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "description",
              "required",
              "repeatable"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "repeatable": {
                "type": "boolean"
              }
            }
          }
        },
        "flags": {
          "description": "Every flag the command accepts, the global flags included.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/flag"
          }
        },
        "format": {
          "type": "string",
          "pattern": "^metais\\.[a-z][a-z0-9-]*/1$"
        },
        "prints": {
          "type": "string",
          "minLength": 1
        },
        "refusals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/refusal"
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "metais.envelope.1.json#/$defs/next"
          }
        }
      },
      "if": {
        "properties": {
          "role": {
            "const": "none"
          }
        }
      },
      "then": {
        "properties": {
          "opens_package": {
            "const": false
          }
        }
      }
    },
    "flag": {
      "type": "object",
      "required": [
        "name",
        "short",
        "value",
        "values",
        "default",
        "repeatable",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "The flag's long spelling.",
          "type": "string",
          "pattern": "^--[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "short": {
          "description": "The one-letter alias, or null.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^-[A-Za-z]$"
            }
          ]
        },
        "value": {
          "description": "The placeholder of the flag's value, or null for a flag that takes none.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "values": {
          "description": "Every value the flag accepts, or null when it accepts any.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "default": {
          "description": "The value in force when the flag is absent, or null.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "repeatable": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "refusal": {
      "type": "object",
      "required": [
        "code",
        "cause",
        "next"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,3}$"
        },
        "cause": {
          "type": "string",
          "minLength": 1
        },
        "next": {
          "$ref": "metais.envelope.1.json#/$defs/next"
        }
      }
    }
  }
}
