{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metais.org/cli/schemas/metais.version.1.json",
  "title": "metais.version/1",
  "description": "What metais version prints with --json: the tool's version and the specification versions it implements (ADR-002 D8 item 1).",
  "$ref": "metais.envelope.1.json",
  "properties": {
    "format": {
      "const": "metais.version/1"
    },
    "result": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/result"
        }
      ]
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "required": [
        "tool",
        "specification"
      ],
      "additionalProperties": false,
      "properties": {
        "tool": {
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "const": "metais"
            },
            "version": {
              "description": "The tool's version, a semantic version without a leading v.",
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
            }
          }
        },
        "specification": {
          "type": "object",
          "required": [
            "implements"
          ],
          "additionalProperties": false,
          "properties": {
            "implements": {
              "description": "Every specification version the tool implements, ascending by major then minor, each listed explicitly.",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
              }
            }
          }
        }
      }
    }
  }
}
